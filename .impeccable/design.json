      "css": ".ds-search{position:relative;display:flex;align-items:center}.ds-search svg{position:absolute;left:12px;width:18px;height:18px;color:var(--muted,#596779);pointer-events:none}.ds-search input{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px;width:100%;height:40px;border:1px solid #cbd3df;border-radius:6px;padding:9px 60px 9px 38px;background:white;color:var(--ink,#1e2938);caret-color:var(--accent,#294fbd)}.ds-search input::placeholder{color:#6a7585}.ds-search input:focus-visible{outline:2px solid var(--accent,#294fbd);outline-offset:3px}"
